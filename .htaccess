Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "accelerometer=(), ambient-light-sensor=(), camera=(), display-capture=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), geolocation=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By

  <Files "index.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://blackfront161.github.io https://raw.githubusercontent.com https://wrn-translation-cache.paghklo.workers.dev https://revolution-proxy.paghklo.workers.dev; media-src 'self' blob: https:; worker-src 'self'; manifest-src 'self'; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com https://kolektiva.media; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  <Files "privacy.html">
    Header always set Content-Security-Policy "default-src 'self'; style-src 'sha256-QVTkmHRW2NXWxlte1EpPstTwqnGN4FOBHnJ0Av5BP0A='; script-src 'sha256-bTDyVMrrbZThJtCeQy3OlsMEzXiJ+5h3SivT90hH6vw='; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  </Files>

  <FilesMatch "^(service-worker\.js|news-app-2-sw\.js)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Service-Worker-Allowed "/"
  </FilesMatch>

  <FilesMatch "\.(?:json|html)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|png|jpe?g|webp|svg|ttf)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(?:env|ini|log|md|ps1|py|sh|sql|toml|ya?ml)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json image/svg+xml text/css text/html text/plain
</IfModule>
